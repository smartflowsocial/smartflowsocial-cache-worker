{
	"name": "smartflowsocial-cache-worker",
	"version": "0.0.0",
	"private": true,
	"description": "Primal-compatible cache API for SmartFlowSocial. Reads NostrMash first and falls back to Primal Cache.",
	"author": "SmartFlowSocial",
	"license": "Unlicense",
	"homepage": "https://smartflow.social",
	"repository": {
		"type": "git",
		"url": "https://github.com/smartflowsocial/smartflowsocial-cache-worker.git"
	},
	"bugs": {
		"url": "https://github.com/smartflowsocial/smartflowsocial-cache-worker/issues"
	},
	"type": "module",
	"packageManager": "pnpm@12.21.0",
	"engines": {
		"node": ">=26.13.1"
	},
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint .",
		"lint:ci": "eslint . --max-warnings 0",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"cf-types": "wrangler types",
		"cf-types:check": "wrangler types && git diff --exit-code worker-configuration.d.ts",
		"validate": "pnpm run format:check && pnpm run lint:ci && pnpm run typecheck && pnpm run cf-types:check && pnpm run test"
	},
	"dependencies": {
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.8.5",
		"@eslint/js": "^10.0.1",
		"@typescript/native": "npm:typescript@7.0.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.14.0",
		"prettier": "3.10.1",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8",
		"vitest": "5.1.1",
		"wrangler": "^4.165.0"
	}
}
